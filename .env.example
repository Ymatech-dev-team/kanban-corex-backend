# Copie para .env (dev) — nunca commitar valores reais.
PORT=3001
LOG_LEVEL=info

# Neon (Escopo 1+) — DATABASE_URL com -pooler; DIRECT_URL sem, para diff/psql
# DATABASE_URL=
# DIRECT_URL=

# Auth (Escopo 3+)
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# INTERNAL_API_SECRET=

# Rate limit (Escopo 3+)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Anexos (Vercel Blob) — criar o store em Storage > Blob e colar o token (dev e prod)
# BLOB_READ_WRITE_TOKEN=

# Foto de perfil (Vercel Blob) — store PÚBLICO separado (avatar aparece pros membros)
# BLOB_PUBLIC_READ_WRITE_TOKEN=

# Workflow: aplicar SQL018 e configurar permissões antes de habilitar.
WORKFLOW_ENABLED=false
# MCP: ver src/modules/mcp/README.md; exige SQL019 e configuração OAuth completa.
MCP_ENABLED=false
# MCP_ISSUER=https://api.example.com/oauth
# MCP_RESOURCE=https://api.example.com/mcp
# MCP_COOKIE_KEYS=
# MCP_JWKS=
# MCP_OAUTH_CLIENTS=
